NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=barbershop
DB_PASSWORD=barbershop
DB_NAME=barbershop

# Gemini (usado a partir da US-15). Troque a chave pela sua (https://aistudio.google.com/apikey).
# Em produção a aplicação exige uma versão fixa do modelo, não um alias -latest.
GEMINI_API_KEY=dev-only-set-your-gemini-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=8000

# Autenticação (usado a partir da US-01). Gere um segredo forte em produção.
JWT_SECRET=dev-only-change-me-0123456789abcdef0123
AUTH_SESSION_TTL_SECONDS=604800
APP_WEB_URL=http://localhost:5173

# E-mail (SMTP). Em dev aponta para o Mailpit do docker-compose.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BarberBot <nao-responda@barberbot.local>"

# WhatsApp (usado a partir da US-13). Evolution API do docker-compose (perfil whatsapp).
# A chave é a AUTHENTICATION_API_KEY da Evolution; o webhook precisa alcançar esta API.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=dev-only-evolution-key
EVOLUTION_TIMEOUT_MS=10000
WHATSAPP_WEBHOOK_URL=http://host.docker.internal:3000/webhooks/whatsapp/evolution
WHATSAPP_WEBHOOK_SECRET=dev-only-change-me-webhook-0123456789abcdef
# Política de privacidade enviada no primeiro contato pelo WhatsApp (US-14).
PRIVACY_POLICY_URL=http://localhost:5173/privacidade
# Horas sem mensagens até o bot voltar numa conversa transferida para humano (US-16).
WHATSAPP_HANDOFF_RESUME_HOURS=12

# Assinatura (US-20). Asaas sandbox; crie a conta em https://sandbox.asaas.com e gere a chave.
# O webhook do Asaas deve apontar para /webhooks/payments/asaas com este token.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=dev-only-set-your-asaas-key
ASAAS_TIMEOUT_MS=10000
ASAAS_WEBHOOK_TOKEN=dev-only-change-me-asaas-webhook-0123456789
# Preço mensal em centavos. Valor de exemplo: o preço ainda não foi definido (PRD seção 19).
SUBSCRIPTION_PRICE_CENTS=9900
# Dias antes do fim do teste para avisar o Dono (CA-20.2, sugestão a validar).
SUBSCRIPTION_TRIAL_WARNING_DAYS=3
# Dias de tolerância depois de uma cobrança recusada antes da suspensão (CA-21.3, sugestão a validar).
SUBSCRIPTION_GRACE_DAYS=5

# Documentação Swagger em /docs (JSON em /docs-json). Desligada se ausente.
API_DOCS_ENABLED=true
